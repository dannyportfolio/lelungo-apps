{
  "$schema": "https://opencode.ai/config.json",
  "default_agent": "plan",
  "instructions": ["AGENTS.md", "openspec/conventions.md"],
  "permission": {
    "external_directory": "deny",
    "edit": "ask",
    "bash": {
      "*": "ask",
      "git status*": "allow",
      "git diff*": "allow",
      "rg *": "allow",
      "npm run lint*": "allow",
      "npm run typecheck*": "allow",
      "npm run test*": "allow",
      "npm run build*": "allow"
    }
  },
  "mcp": {}
}
