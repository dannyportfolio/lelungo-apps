{
  "$schema": "https://opencode.ai/config.json",
  "provider": {
    "9router": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "9Router",
      "options": {
        "baseURL": "{env:LELUNGO_AI_GATEWAY_BASE_URL}",
        "apiKey": "{env:LELUNGO_AI_GATEWAY_API_KEY}"
      },
      "models": {
        "premium-coding": {
          "name": "9Router premium coding route"
        }
      }
    }
  },
  "model": "9router/premium-coding"
}
