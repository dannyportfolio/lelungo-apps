# Supabase Project URL (from Project Settings → API)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co

# Supabase Anon Key (from Project Settings → API)
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here

# Supabase Service Role Key (keep secret — only used server-side)
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# Public site URL used for canonical and social metadata
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# PostgreSQL connection for Prisma. This must remain server-only.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/lelungo?schema=public

# Tenant hostname resolution. Enable <tenant>.localhost only for local development.
LELUNGO_ROOT_DOMAIN=lelungo.com
LELUNGO_LOCAL_ROOT_DOMAIN=localhost
LELUNGO_ENABLE_LOCAL_TENANT_HOSTS=false

# Optional dormant server-side OTA adapter. Never prefix credentials with NEXT_PUBLIC_.
TRAVELOKA_BASE_URL=
TRAVELOKA_APP_KEY=
