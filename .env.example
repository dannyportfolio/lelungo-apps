# Public Supabase configuration. Set both values together for /auth/* and /staff*.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
NEXT_PUBLIC_APP_ENV=development
NEXT_PUBLIC_SITE_URL=http://localhost:3000
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/lelungo?schema=public
# Disposable test database only. Never reuse DATABASE_URL or a deployed database.
TEST_DATABASE_URL=postgresql://postgres:postgres@localhost:5432/lelungo_test?schema=public
LELUNGO_ROOT_DOMAIN=lelungo.com
LELUNGO_LOCAL_ROOT_DOMAIN=localhost
LELUNGO_ENABLE_LOCAL_TENANT_HOSTS=false
# Optional E2E auth-provider override. Playwright uses a local fake when these are empty.
E2E_SUPABASE_URL=
E2E_SUPABASE_PUBLIC_KEY=
PLAYWRIGHT_SKIP_WEBSERVER=false
PLAYWRIGHT_USE_PRODUCTION_SERVER=false
TRAVELOKA_BASE_URL=
TRAVELOKA_APP_KEY=
